; npm 12 refuses git dependencies by default. The pinned PDF converter is a git
; devDependency, so allow git fetches for development installs. "all" rather
; than "root": older npm 11 releases (e.g. 11.12.1) do not treat a lockfile
; entry as root during npm ci and reject it with EALLOWGIT. The converter is
; the only git dependency in package-lock.json, and the published package has
; none, so consumers are unaffected.
allow-git=all
