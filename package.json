{
  "name": "ksefctl",
  "version": "2026.02.21",
  "description": "CLI background service for KSeF inbox synchronization",
  "license": "Apache-2.0",
  "bin": {
    "ksefctl": "bin/ksefctl"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "npm --prefix node_modules/@akmf/ksef-fe-invoice-converter install && node scripts/patch-api-extractor.cjs && npm --prefix node_modules/@akmf/ksef-fe-invoice-converter run build && node scripts/prepare-ksef-pdf-generator.cjs",
    "solution": "npm ci && npm run lint:fix && npm run build && npm run test && npm run test:integration && npm link",
    "test": "NODE_OPTIONS= vitest run",
    "test:integration": "NODE_OPTIONS= NODE_NO_WARNINGS=1 vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@akmf/ksef-fe-invoice-converter": "github:CIRFMF/ksef-pdf-generator#main",
    "adm-zip": "^0.5.10",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "keytar": "^7.9.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^8.0.1",
    "ora": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "proper-lockfile": "^4.1.2",
    "sql.js": "^1.10.3",
    "undici": "^6.19.2",
    "xml-js": "^1.6.11",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.7",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^6.4.15",
    "@types/proper-lockfile": "^4.1.3",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.21.0",
    "globals": "^16.0.0",
    "msw": "^2.4.9",
    "openapi-typescript": "^7.5.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
