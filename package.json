{
  "name": "@blazejpawlak/ksefctl",
  "version": "2026.9.21",
  "description": "CLI background service for KSeF inbox synchronization",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blazejpawlak/ksefctl.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "ksefctl": "bin/ksefctl"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=26"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "node scripts/prepare-ksef-pdf-generator.mjs",
    "solution": "npm ci && npm run lint:fix && npm run build && npm run test && npm run test:integration && npm link --force",
    "test": "NODE_OPTIONS= vitest run",
    "test:integration": "NODE_OPTIONS= NODE_NO_WARNINGS=1 vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@akmf/ksef-fe-invoice-converter": "github:CIRFMF/ksef-pdf-generator#fb12569a439a391a8e0c705e7dc331079be8c942",
    "adm-zip": "^0.6.1",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "keytar": "^7.9.0",
    "node-notifier": "^10.0.1",
    "nodemailer": "^10.0.15",
    "ora": "^5.4.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "proper-lockfile": "^4.1.2",
    "sql.js": "^1.14.2",
    "undici": "^8.11.2",
    "xml-js": "^1.6.11",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "node-notifier": {
      "uuid": "^11.1.1"
    },
    "@akmf/ksef-fe-invoice-converter": {
      "i18next-http-backend": "^4.0.2"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^8.0.2",
    "@types/proper-lockfile": "^4.1.3",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.21.0",
    "globals": "^16.0.0",
    "msw": "^3.0.2",
    "openapi-typescript": "^7.5.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
